{
  "name": "saferoute-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "expo start",
    "start:maestro:ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:logic": "tsx --test test/*.test.ts",
    "test:maestro:ios": "maestro test maestro/ios-preview-route-live-map.yaml",
    "test": "npm run typecheck && npm run test:logic"
  },
  "dependencies": {
    "expo": "~56.0.15",
    "expo-constants": "~56.0.20",
    "expo-location": "~56.0.20",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-maps": "1.27.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~56.0.15",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}
