{
  "name": "saferoute-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "expo start",
    "repair:maestro:ios:expo-go": "node scripts/install-maestro-expo-go.mjs",
    "prestart:maestro:ios": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:navigation-resume": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:auth": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:auth-code": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:session-expired": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:operations": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:risk-areas": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:saved-routes": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:routes-empty": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:active-workspace": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:workspace-choice": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:guidance-suspended": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:guidance-contract": "node scripts/maestro-ios-preflight.mjs",
    "start:maestro:ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:guidance-contract": "SAFEROUTE_SOURCE_REVISION=$(git rev-parse HEAD) SAFEROUTE_ENABLE_GUIDANCE_CONTRACT_EVIDENCE=true SAFEROUTE_ENABLE_PREVIEW_MODE=false SAFEROUTE_ENABLE_DEMO_DRIVE=false SAFEROUTE_DEV_API_URL=http://127.0.0.1:18080 NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:logic": "tsx --test test/*.test.ts",
    "test:maestro:ios": "node scripts/run-maestro.mjs test maestro/ios-preview-route-live-map.yaml",
    "test:maestro:ios:saved-routes": "node scripts/run-maestro.mjs test maestro/ios-preview-saved-routes.yaml",
    "test": "npm run typecheck && npm run test:logic",
    "start:maestro:ios:preview:auth": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=login NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:auth-code": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=login-code NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:session-expired": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=session-expired NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:operations": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=operations NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview": "SAFEROUTE_ENABLE_PREVIEW_MODE=true NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:navigation-resume": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_ENABLE_DEMO_DRIVE=false SAFEROUTE_PREVIEW_INITIAL_SCREEN=guest-map NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:risk-areas": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=guest-map NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:saved-routes": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=routes NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:routes-empty": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=routes-empty NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:active-workspace": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=guest-map NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:workspace-choice": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=workspace-choice NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:guidance-suspended": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=guidance-suspended NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "test:maestro:ios:operations": "node scripts/run-maestro.mjs test maestro/ios-preview-operations.yaml",
    "test:maestro:ios:map-interactions": "node scripts/run-maestro.mjs test maestro/ios-preview-map-interactions.yaml",
    "test:maestro:ios:risk-areas": "node scripts/run-maestro.mjs test maestro/ios-preview-risk-areas.yaml",
    "test:maestro:ios:auth": "node scripts/run-maestro.mjs test maestro/ios-auth-ui.yaml",
    "test:maestro:ios:auth-code": "node scripts/run-maestro.mjs test maestro/ios-auth-code-ui.yaml",
    "test:maestro:ios:session-expired": "node scripts/run-maestro.mjs test maestro/ios-auth-session-expired-ui.yaml",
    "test:maestro:ios:routes-empty": "node scripts/run-maestro.mjs test maestro/ios-preview-routes-empty.yaml",
    "test:maestro:ios:navigation-resume": "node scripts/run-maestro.mjs test maestro/ios-preview-navigation-resume.yaml",
    "test:maestro:ios:active-workspace": "node scripts/run-maestro.mjs test maestro/ios-preview-active-workspace.yaml",
    "test:maestro:ios:workspace-choice": "node scripts/run-maestro.mjs test maestro/ios-preview-workspace-choice.yaml",
    "test:maestro:ios:guidance-suspended": "node scripts/run-maestro.mjs test maestro/ios-preview-guidance-suspended.yaml",
    "test:maestro:ios:guidance-contract": "node scripts/run-maestro-guidance-contract.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2"
  }
}
