{
  "name": "saferoute-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "expo start",
    "prestart:maestro:ios": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview": "node scripts/maestro-ios-preflight.mjs",
    "prestart:maestro:ios:preview:saved-routes": "node scripts/maestro-ios-preflight.mjs",
    "start:maestro:ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:logic": "tsx --test test/*.test.ts",
    "test:maestro:ios": "node scripts/run-maestro.mjs test maestro/ios-preview-route-live-map.yaml",
    "test:maestro:ios:saved-routes": "node scripts/run-maestro.mjs test maestro/ios-preview-saved-routes.yaml",
    "test": "npm run typecheck && npm run test:logic",
    "start:maestro:ios:preview": "SAFEROUTE_ENABLE_PREVIEW_MODE=true NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:maestro:ios:preview:saved-routes": "SAFEROUTE_ENABLE_PREVIEW_MODE=true SAFEROUTE_PREVIEW_INITIAL_SCREEN=routes NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "test:maestro:ios:operations": "node scripts/run-maestro.mjs test maestro/ios-preview-operations.yaml",
    "test:maestro:ios:map-interactions": "node scripts/run-maestro.mjs test maestro/ios-preview-map-interactions.yaml",
    "test:maestro:ios:risk-areas": "node scripts/run-maestro.mjs test maestro/ios-preview-risk-areas.yaml",
    "test:maestro:ios:auth": "node scripts/run-maestro.mjs test maestro/ios-auth-ui.yaml"
  },
  "dependencies": {
    "expo": "~56.0.15",
    "expo-constants": "~56.0.20",
    "expo-location": "~56.0.20",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~56.0.15",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}
