+- (void)setShowsUserHeadingIndicator:(BOOL)showsUserHeadingIndicator
+{
+    if (_showsUserHeadingIndicator == showsUserHeadingIndicator) {
+        return;
+    }
+
+    _showsUserHeadingIndicator = showsUserHeadingIndicator;
+    if (!showsUserHeadingIndicator || ![CLLocationManager headingAvailable]) {
+        [self.userHeadingLocationManager stopUpdatingHeading];
+        self.userHeadingLocationManager.delegate = nil;
+        self.userHeadingLocationManager = nil;
+        [self.userHeadingIndicatorView removeFromSuperview];
+        self.userHeadingIndicatorView = nil;
+        self.nativeUserLocationView = nil;
+        return;
+    }
+
+    CLLocationManager *headingManager = [CLLocationManager new];
+    headingManager.delegate = self;
+    headingManager.headingFilter = 1.0;
+    self.userHeadingLocationManager = headingManager;
+    [headingManager startUpdatingHeading];
+    MKAnnotationView *userLocationView = [self viewForAnnotation:self.userLocation];
+    if (userLocationView) {
+        [self attachUserHeadingIndicatorToAnnotationView:userLocationView];
+    }
+}
+
+- (void)dealloc
+{
+    [self.userHeadingLocationManager stopUpdatingHeading];
+    self.userHeadingLocationManager.delegate = nil;
+}
+
+- (void)attachUserHeadingIndicatorToAnnotationView:(MKAnnotationView *)view
+{
+    if (!self.showsUserHeadingIndicator || !view) {
+        return;
+    }
+
+    if (self.nativeUserLocationView == view && self.userHeadingIndicatorView.superview == view) {
+        return;
+    }
+
+    [self.userHeadingIndicatorView removeFromSuperview];
+    self.nativeUserLocationView = view;
+    view.clipsToBounds = NO;
+
+    const CGFloat indicatorSize = 72.0;
+    UIView *indicator = [[UIView alloc] initWithFrame:CGRectMake(
+        (CGRectGetWidth(view.bounds) - indicatorSize) / 2.0,
+        (CGRectGetHeight(view.bounds) - indicatorSize) / 2.0,
+        indicatorSize,
+        indicatorSize
+    )];
+    indicator.userInteractionEnabled = NO;
+    indicator.isAccessibilityElement = NO;
+    indicator.accessibilityElementsHidden = YES;
+
+    CAGradientLayer *gradient = [CAGradientLayer layer];
+    gradient.frame = indicator.bounds;
+    gradient.startPoint = CGPointMake(0.5, 1.0);
+    gradient.endPoint = CGPointMake(0.5, 0.0);
+    gradient.colors = @[
+        (id)[UIColor colorWithRed:10.0 / 255.0 green:132.0 / 255.0 blue:1.0 alpha:0.34].CGColor,
+        (id)[UIColor colorWithRed:10.0 / 255.0 green:132.0 / 255.0 blue:1.0 alpha:0.14].CGColor,
+        (id)[UIColor colorWithRed:10.0 / 255.0 green:132.0 / 255.0 blue:1.0 alpha:0.0].CGColor,
+    ];
+    gradient.locations = @[@0.0, @0.72, @1.0];
+
+    UIBezierPath *fanPath = [UIBezierPath bezierPath];
+    [fanPath moveToPoint:CGPointMake(36.0, 36.0)];
+    [fanPath addCurveToPoint:CGPointMake(18.0, 6.0)
+               controlPoint1:CGPointMake(29.0, 29.0)
+               controlPoint2:CGPointMake(22.0, 18.0)];
+    [fanPath addQuadCurveToPoint:CGPointMake(54.0, 6.0)
+                    controlPoint:CGPointMake(36.0, -1.0)];
+    [fanPath addCurveToPoint:CGPointMake(36.0, 36.0)
+               controlPoint1:CGPointMake(50.0, 18.0)
+               controlPoint2:CGPointMake(43.0, 29.0)];
+    [fanPath closePath];
+
+    CAShapeLayer *fanMask = [CAShapeLayer layer];
+    fanMask.frame = indicator.bounds;
+    fanMask.path = fanPath.CGPath;
+    gradient.mask = fanMask;
+    [indicator.layer addSublayer:gradient];
+
+    [view insertSubview:indicator atIndex:0];
+    self.userHeadingIndicatorView = indicator;
+    [self updateUserHeadingIndicatorAnimated:NO];
+}
+
+- (void)locationManager:(CLLocationManager *)manager didUpdateHeading:(CLHeading *)newHeading
+{
+    CLLocationDirection heading = newHeading.trueHeading >= 0.0
+        ? newHeading.trueHeading
+        : newHeading.magneticHeading;
+    if (heading < 0.0 || !isfinite(heading)) {
+        return;
+    }
+    self.lastUserHeadingDegrees = heading;
+    [self updateUserHeadingIndicatorAnimated:YES];
+}
+
+- (BOOL)locationManagerShouldDisplayHeadingCalibration:(CLLocationManager *)manager
+{
+    return NO;
+}
+
+- (void)refreshUserHeadingIndicator
+{
+    [self updateUserHeadingIndicatorAnimated:NO];
+}
+
+- (void)updateUserHeadingIndicatorAnimated:(BOOL)animated
+{
+    if (!self.userHeadingIndicatorView || self.lastUserHeadingDegrees < 0.0 || !isfinite(self.lastUserHeadingDegrees)) {
+        self.userHeadingIndicatorView.hidden = YES;
+        return;
+    }
+
+    self.userHeadingIndicatorView.hidden = NO;
+    CLLocationDirection screenHeading = self.lastUserHeadingDegrees - self.camera.heading;
+    CGFloat radians = screenHeading * M_PI / 180.0;
+    void (^updates)(void) = ^{
+        self.userHeadingIndicatorView.transform = CGAffineTransformMakeRotation(radians);
+    };
+    if (animated) {
+        [UIView animateWithDuration:0.14
+                              delay:0
+                            options:UIViewAnimationOptionBeginFromCurrentState |
+                                    UIViewAnimationOptionAllowUserInteraction |
+                                    UIViewAnimationOptionCurveEaseOut
+                         animations:updates
+                         completion:nil];
+    } else {
+        updates();
+    }
+}
